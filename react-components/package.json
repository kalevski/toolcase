{
	"name": "@toolcase/react-components",
	"version": "2.6.1",
	"main": "lib/index.main.js",
	"module": "lib/index.module.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.module.js",
			"require": "./lib/index.main.js"
		},
		"./style.css": "./lib/index.css"
	},
	"sideEffects": ["*.css"],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup && sass style/index.scss:lib/index.css --no-source-map --style=compressed --load-path=../node_modules --quiet-deps --silence-deprecation=import --silence-deprecation=color-functions --silence-deprecation=global-builtin",
		"build:css": "sass style/index.scss:lib/index.css --no-source-map --style=compressed --load-path=../node_modules --quiet-deps --silence-deprecation=import --silence-deprecation=color-functions --silence-deprecation=global-builtin"
	},
	"peerDependencies": {
		"@toolcase/base": "2.x.x",
		"react": ">=18",
		"react-dom": ">=18"
	},
	"dependencies": {
		"dropzone": "^6.0.0-beta.2"
	},
	"directories": {
		"lib": "lib"
	},
	"files": [
		"lib"
	]
}
