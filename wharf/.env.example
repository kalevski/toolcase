# ── Required ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# Public origin (scheme + host) the browser uses. Defaults to the origin of
# OAUTH_REDIRECT_URI. Only set when they differ (e.g. a proxy strips the path).
# PUBLIC_ORIGIN=https://wharf.example.com
AUTH_SECRET=                       # HMAC key for session + OAuth state, e.g. `openssl rand -hex 32`
# Encryption key for values at rest (secrets, notes, env literals) AND backups.
# 32-byte hex (64 chars), e.g. `openssl rand -hex 32`. Distinct from AUTH_SECRET.
ENCRYPTION_KEY=
# Previous encryption key, kept during a key rotation so old ciphertext/backups
# stay readable. Move the old ENCRYPTION_KEY here when rotating; remove once
# every row has been re-encrypted.
# ENCRYPTION_KEY_PREV=

# ── Optional: auth ───────────────────────────────────────────────────────────
# GITHUB_ALLOWED_LOGINS=octocat,hubot
# GITHUB_ALLOWED_ORG=my-org
SESSION_TTL=86400

# ── Optional: workspace / storage ────────────────────────────────────────────
WORKSPACE_DIR=/workspace
# SQLite system-of-record. Defaults to $WORKSPACE_DIR/wharf.db.
# Requires Node >= 22.5 (Node 24 recommended) for the built-in node:sqlite module.
# DB_PATH=/workspace/wharf.db
# Encrypted DB snapshots are written here (host-owned volume).
BACKUP_DIR=/workspace/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
AUDIT_RETENTION_DAYS=90

# ── Dashboard (human, GitHub-authenticated, public) ──────────────────────────
PORT=3000

# ── Agent API (machine, instance-key, internal-only) ─────────────────────────
# A second HTTP listener in the SAME process. Bind it to the internal Docker
# network — NEVER publish it externally. Serves resolved config + the wharf-client
# binaries to containers.
AGENT_PORT=4000
AGENT_HOST=0.0.0.0
# Where the cross-compiled wharf-client binaries + checksums.txt live (baked into
# the image by the Dockerfile `client` stage). Served at /v1/client/*.
WHARF_CLIENT_DIR=/app/wharf/client-bin
