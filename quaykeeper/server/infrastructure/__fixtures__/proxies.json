{
    "proxies": [
        {
            "domain": "api.example.com",
            "upstream": "api_pool",
            "connect_timeout": "5s",
            "read_timeout": "1m0s",
            "client_max_body_size": "512MiB",
            "tls": "required",
            "force_ssl": true,
            "http2": true,
            "hsts": { "enabled": true, "max_age": 63072000, "include_subdomains": true, "preload": true },
            "block_exploits": true,
            "gzip": true,
            "websocket": true,
            "cache": {},
            "locations": [
                { "path": "/", "websocket": true },
                {
                    "path": "/uploads",
                    "pass": "http://127.0.0.1:9000",
                    "advanced": "proxy_buffering off;"
                }
            ]
        },
        {
            "domain": "*.apps.example.com",
            "enabled": false,
            "pass": "http://127.0.0.1:3000",
            "advanced": "add_header X-Frame-Options SAMEORIGIN;"
        }
    ]
}
