{
    "name": "@toolcase/logging",
    "version": "4.0.0",
    "description": "Tiny isomorphic logger for Node.js and the browser — colored output, log levels, named reporters, zero dependencies.",
    "source": "src/main.js",
    "main": "lib/main.main.js",
    "module": "lib/main.module.js",
    "types": "lib/main.d.ts",
    "exports": {
        ".": {
            "types": "./lib/main.d.ts",
            "import": "./lib/main.module.js",
            "require": "./lib/main.main.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.module.js",
            "require": "./lib/node.main.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup"
    },
    "author": {
        "name": "Daniel Kalevski",
        "url": "https://kalevski.dev"
    },
    "homepage": "https://toolcase.kalevski.dev",
    "keywords": [
        "toolcase",
        "logger",
        "logging",
        "console",
        "log",
        "reporter",
        "isomorphic",
        "universal",
        "lightweight",
        "tiny",
        "typescript",
        "esm",
        "nodejs",
        "browser",
        "zero-dependency"
    ],
    "directories": {
        "lib": "lib"
    },
    "files": [
        "lib"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kalevski/toolcase.git",
        "directory": "logging"
    },
    "bugs": {
        "url": "https://github.com/kalevski/toolcase/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT"
}
