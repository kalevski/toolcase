lib
# taskforge uses lib/ as a SOURCE dir (Next.js app helpers), not build output — keep it tracked
!taskforge/lib/
node_modules
.parcel-cache
.DS_Store
examples/dist
!examples/dist/CNAME
tasks/*.md
tasks/logs/*.log

# TaskForge multi-account registry — per-alias Claude config dirs hold
# `.credentials.json` OAuth tokens (real secrets); never commit them.
.claude-accounts/
taskforge.db
taskforge.db-*