lib
# taskforge & quaykeeper use lib/ as a SOURCE dir (Next.js app helpers — the
# @/lib/tc web-components interop shim), not build output — keep it tracked.
!taskforge/lib/
!quaykeeper/lib/
!voxscribe/lib/
node_modules
.parcel-cache
.DS_Store

# Docker stack secrets (docker-compose.yml reads root .env). Never commit.
.env
.env*.local
examples/dist
!examples/dist/CNAME
tasks/*.md
tasks/logs/*.log

# TaskForge multi-account registry — per-alias Claude config dirs hold
# `.credentials.json` OAuth tokens (real secrets); never commit them.
.claude-accounts/
taskforge.db
taskforge.db-*