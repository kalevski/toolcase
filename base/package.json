{
    "name": "@toolcase/base",
    "version": "2.0.0",
    "description": "🧬 Collection of JavaScript helper functions and structures",
    "source": "src/main.js",
    "main": "lib/main.main.js",
    "module": "lib/main.module.js",
    "types": "lib/main.d.ts",
    "exports": {
        ".": {
            "types": "./lib/main.d.ts",
            "import": "./lib/main.module.js",
            "require": "./lib/main.main.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.module.js",
            "require": "./lib/node.main.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup"
    },
    "homepage": "https://kalevski.dev/toolcase",
    "keywords": [
        "helpers",
        "utils",
        "functions",
        "toolcase",
        "nodejs",
        "browser"
    ],
    "directories": {
        "lib": "lib"
    },
    "files": [
        "lib"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kalevski/toolcase.git"
    },
    "bugs": {
        "url": "https://github.com/kalevski/toolcase/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT"
}
