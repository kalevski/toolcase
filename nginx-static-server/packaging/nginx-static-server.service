[Unit]
Description=nginx-static-server — keep nginx static site directories in sync with remote sources
Documentation=https://github.com/kalevski/toolcase/tree/main/nginx-static-server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/nginx-static-server run --config /etc/nginx-static-server/config.yml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

User=nginx-static
Group=nginx-static
UMask=0027

# Hardening (spec §6, Q24) — the daemon runs unprivileged and only ever
# writes inside its data_dir.
ProtectSystem=strict
ReadWritePaths=/var/lib/nginx-static-server
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Secrets: prefer environment files or systemd LoadCredential + *_file refs.
# EnvironmentFile=-/etc/nginx-static-server/env

[Install]
WantedBy=multi-user.target
