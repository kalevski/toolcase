{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "noEmit": false,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "removeComments": false,
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["lib", "node_modules"]
}
