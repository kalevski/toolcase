# Every app-owned variable is namespaced TASKFORGE_*; the bare (unprefixed) name
# still works as a fallback for existing deployments. Shared infra knobs
# (PORT, DB_PATH, WORKSPACE_DIR) conventionally stay bare.

# ── Required ───────────────────────────────────────────────────────────────
TASKFORGE_GITHUB_CLIENT_ID=
TASKFORGE_GITHUB_CLIENT_SECRET=
TASKFORGE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# Public origin (scheme + host) the browser uses. Defaults to the origin of
# TASKFORGE_OAUTH_REDIRECT_URI. Only set when they differ (e.g. proxy strips the path).
# TASKFORGE_PUBLIC_ORIGIN=https://tasks.example.com
TASKFORGE_AUTH_SECRET=             # HMAC key for session + OAuth state (use a long random string)
# No ANTHROPIC_API_KEY: the `claude` CLI authenticates itself (run `claude login`
# in the container / on the host, or mount its credential store).

# ── Optional: auth ───────────────────────────────────────────────────────────
# TASKFORGE_GITHUB_ALLOWED_LOGINS=octocat,hubot
# TASKFORGE_GITHUB_ALLOWED_ORG=my-org
TASKFORGE_SESSION_TTL=86400

# ── Optional: workspace ──────────────────────────────────────────────────────
WORKSPACE_DIR=/workspace
# TASKFORGE_SKILLS_DIR=/workspace/skills
# SQLite system-of-record. Defaults to $WORKSPACE_DIR/taskforge.db.
# Requires Node >= 22.5 (Node 24 recommended) for the built-in node:sqlite module.
# DB_PATH=/workspace/taskforge.db

# ── Optional: agent / model ──────────────────────────────────────────────────
# TASKFORGE_CLAUDE_BIN=claude       # path to the claude binary the app spawns
# Fallback Claude account alias (multi-account registry) when a task/project
# names none. Empty = use the inherited identity (single-account behavior).
# Per-alias config dirs live under $WORKSPACE_DIR/.claude-accounts/<alias>/.
# API-key aliases reference their key by env-var NAME from the registry (e.g.
# "env": "TASKFORGE_CIBOT_KEY") — define that var below; never store the key
# value in the registry. OAuth aliases need no env var (token lives in the dir).
# See the README "Multiple Claude accounts" section for the full workflow.
# TASKFORGE_DEFAULT_ACCOUNT=
# TASKFORGE_CIBOT_KEY=              # example: API key for an api-key alias (name referenced from the registry)
TASKFORGE_DEFAULT_MODEL=claude-sonnet-4-6
TASKFORGE_MODEL_CATALOG=fast,mid,deep,claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-8
TASKFORGE_AGENT_EXTRA_ARGS=--print --output-format=stream-json --verbose --permission-mode acceptEdits

# ── Optional: limit / retry behavior ─────────────────────────────────────────
TASKFORGE_LIMIT_AUTO_SLEEP=1
TASKFORGE_LIMIT_SLEEP_BUFFER=60
TASKFORGE_LIMIT_SLEEP_FALLBACK=1800
TASKFORGE_LIMIT_SLEEP_MAX=21600
TASKFORGE_LIMIT_MAX_RETRIES=5
TASKFORGE_TRANSIENT_MAX_RETRIES=3
TASKFORGE_TRANSIENT_BASE_DELAY=10

# ── Optional: usage gate (pre-emptive pause near the usage cap) ───────────────
# After each task, run /usage (local, no tokens); pause until usage drops if any
# bucket is at/above the threshold, so the next task does not fail on the limit.
TASKFORGE_USAGE_GATE_ENABLED=1
TASKFORGE_USAGE_GATE_THRESHOLD=95
TASKFORGE_USAGE_GATE_POLL_SECONDS=1800

# ── Optional: warm session ───────────────────────────────────────────────────
TASKFORGE_WARM_SESSION=0
TASKFORGE_WARM_SESSION_MAX_AGE=14400

# ── Optional: process / generate ─────────────────────────────────────────────
# Agent watchdog timeouts. Set to 0 to disable (run unbounded).
# TASKFORGE_GENERATE_TIMEOUT_MS    → task-creator
# TASKFORGE_KNOWLEDGE_TIMEOUT_MS   → knowledge-writer, note-writer, all custom agents
TASKFORGE_FORCE_KILL_GRACE_MS=5000
# Agent one-shot timeout (task generation, /usage refresh). 0 = no timeout.
TASKFORGE_GENERATE_TIMEOUT_MS=120000
TASKFORGE_KNOWLEDGE_TIMEOUT_MS=300000

# ── Optional: commit / git ───────────────────────────────────────────────────
TASKFORGE_COMMIT_AFTER_TASK=0
TASKFORGE_COMMIT_MESSAGE_MODE=taskname        # taskname | ai
TASKFORGE_COMMIT_MODEL=claude-haiku-4-5
TASKFORGE_GIT_AUTHOR_NAME=taskforge
TASKFORGE_GIT_AUTHOR_EMAIL=bot@taskforge.local
# TASKFORGE_GIT_REMOTE_TOKEN=       # HTTPS token for `git push` (GitHub scope `repo`)
# Git op timeouts so a hung command can't wedge a run (0 = no timeout).
TASKFORGE_GIT_TIMEOUT_MS=120000               # local ops (status/diff/commit/branch)
TASKFORGE_GIT_REMOTE_TIMEOUT_MS=600000        # remote ops (clone/fetch/pull/push)

# ── Optional: logs / notify ──────────────────────────────────────────────────
TASKFORGE_LOG_RETENTION_HOURS=168
# TASKFORGE_SLACK_WEBHOOK_URL=
# Event-level notifications (D2): which events fire, and an optional generic
# JSON webhook (ntfy/Discord/automation). Per-project settings override both.
# TASKFORGE_NOTIFY_EVENTS=run:completed,run:errored,task:error,limit,agent:done
# TASKFORGE_NOTIFY_WEBHOOK_URL=

# ── Optional: reviewer pass (B8) ─────────────────────────────────────────────
TASKFORGE_REVIEW_MODEL=claude-haiku-4-5
# 0 = no timeout.
TASKFORGE_REVIEW_TIMEOUT_MS=120000

PORT=3000

# ── Docker: use the HOST machine's claude CLI (Linux host) ────────────────────
# Read by docker-compose.yml interpolation (not by the app). Install claude on the
# host and run `claude login` once, then point these at the host paths. The host
# must share the container's CPU arch. See the README for the uid/permissions note.
# HOST_CLAUDE_BIN=/root/.local/bin/claude   # host claude binary (native install)
# HOST_CLAUDE_CONFIG=/root/.claude          # host login dir (holds .credentials.json)
# RUN_AS=0:0                                # uid:gid that owns ~/.claude + /workspace
# CLAUDE_CONFIG_DIR=/home/app/.claude       # where the in-container claude reads config
