# ── Required ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# Public origin (scheme + host) the browser uses. Defaults to the origin of
# OAUTH_REDIRECT_URI. Only set when they differ (e.g. proxy strips the path).
# PUBLIC_ORIGIN=https://tasks.example.com
AUTH_SECRET=                       # HMAC key for session + OAuth state (use a long random string)
# No ANTHROPIC_API_KEY: the `claude` CLI authenticates itself (run `claude login`
# in the container / on the host, or mount its credential store).

# ── Optional: auth ───────────────────────────────────────────────────────────
# GITHUB_ALLOWED_LOGINS=octocat,hubot
# GITHUB_ALLOWED_ORG=my-org
SESSION_TTL=86400

# ── Optional: workspace ──────────────────────────────────────────────────────
WORKSPACE_DIR=/workspace
# SKILLS_DIR=/workspace/skills
# SQLite system-of-record. Defaults to $WORKSPACE_DIR/taskforge.db.
# Requires Node >= 22.5 (Node 24 recommended) for the built-in node:sqlite module.
# DB_PATH=/workspace/taskforge.db

# ── Optional: agent / model ──────────────────────────────────────────────────
# CLAUDE_BIN=claude                 # path to the claude binary the app spawns
DEFAULT_MODEL=claude-sonnet-4-6
MODEL_CATALOG=fast,mid,deep,claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-8
AGENT_EXTRA_ARGS=--print --output-format=stream-json --verbose --permission-mode acceptEdits

# ── Optional: limit / retry behavior ─────────────────────────────────────────
LIMIT_AUTO_SLEEP=1
LIMIT_SLEEP_BUFFER=60
LIMIT_SLEEP_FALLBACK=1800
LIMIT_SLEEP_MAX=21600
LIMIT_MAX_RETRIES=5
TRANSIENT_MAX_RETRIES=3
TRANSIENT_BASE_DELAY=10

# ── Optional: usage gate (pre-emptive pause near the usage cap) ───────────────
# After each task, run /usage (local, no tokens); pause until usage drops if any
# bucket is at/above the threshold, so the next task does not fail on the limit.
USAGE_GATE_ENABLED=1
USAGE_GATE_THRESHOLD=95
USAGE_GATE_POLL_SECONDS=1800

# ── Optional: warm session ───────────────────────────────────────────────────
WARM_SESSION=0
WARM_SESSION_MAX_AGE=14400

# ── Optional: process / generate ─────────────────────────────────────────────
# Agent watchdog timeouts. Set to 0 to disable (run unbounded).
# GENERATE_TIMEOUT_MS    → task-creator
# KNOWLEDGE_TIMEOUT_MS   → knowledge-writer, note-writer, all custom agents
FORCE_KILL_GRACE_MS=5000
# Agent one-shot timeout (task generation, /usage refresh). 0 = no timeout.
GENERATE_TIMEOUT_MS=120000
KNOWLEDGE_TIMEOUT_MS=300000

# ── Optional: commit / git ───────────────────────────────────────────────────
COMMIT_AFTER_TASK=0
COMMIT_MESSAGE_MODE=taskname        # taskname | ai
COMMIT_MODEL=claude-haiku-4-5
GIT_AUTHOR_NAME=taskforge
GIT_AUTHOR_EMAIL=bot@taskforge.local
# GIT_REMOTE_TOKEN=                 # HTTPS token for `git push` (GitHub scope `repo`)
# Git op timeouts so a hung command can't wedge a run (0 = no timeout).
GIT_TIMEOUT_MS=120000               # local ops (status/diff/commit/branch)
GIT_REMOTE_TIMEOUT_MS=600000        # remote ops (clone/fetch/pull/push)

# ── Optional: logs / notify ──────────────────────────────────────────────────
LOG_RETENTION_HOURS=168
# SLACK_WEBHOOK_URL=
# Event-level notifications (D2): which events fire, and an optional generic
# JSON webhook (ntfy/Discord/automation). Per-project settings override both.
# NOTIFY_EVENTS=run:completed,run:errored,task:error,limit,agent:done
# NOTIFY_WEBHOOK_URL=

# ── Optional: reviewer pass (B8) ─────────────────────────────────────────────
REVIEW_MODEL=claude-haiku-4-5
# 0 = no timeout.
REVIEW_TIMEOUT_MS=120000

PORT=3000

# ── Docker: use the HOST machine's claude CLI (Linux host) ────────────────────
# Read by docker-compose.yml interpolation (not by the app). Install claude on the
# host and run `claude login` once, then point these at the host paths. The host
# must share the container's CPU arch. See the README for the uid/permissions note.
# HOST_CLAUDE_BIN=/root/.local/bin/claude   # host claude binary (native install)
# HOST_CLAUDE_CONFIG=/root/.claude          # host login dir (holds .credentials.json)
# RUN_AS=0:0                                # uid:gid that owns ~/.claude + /workspace
# CLAUDE_CONFIG_DIR=/home/app/.claude       # where the in-container claude reads config
