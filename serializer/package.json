{
    "name": "@toolcase/serializer",
    "version": "5.0.0",
    "description": "Compact protobuf-based binary serializer — fast schema-driven encode/decode for Node.js and the browser.",
    "main": "lib/main.main.js",
    "module": "lib/main.module.js",
    "types": "lib/main.d.ts",
    "exports": {
        ".": {
            "types": "./lib/main.d.ts",
            "import": "./lib/main.module.js",
            "require": "./lib/main.main.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup"
    },
    "dependencies": {
        "protobufjs": "^8.0.1"
    },
    "author": {
        "name": "Daniel Kalevski",
        "url": "https://kalevski.dev"
    },
    "homepage": "https://toolcase.kalevski.dev",
    "keywords": [
        "toolcase",
        "serializer",
        "serialization",
        "protobuf",
        "protocol-buffers",
        "binary",
        "encode",
        "decode",
        "schema",
        "typescript",
        "esm",
        "nodejs",
        "browser"
    ],
    "files": [
        "lib"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kalevski/toolcase.git",
        "directory": "serializer"
    },
    "bugs": {
        "url": "https://github.com/kalevski/toolcase/issues"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MIT"
}
