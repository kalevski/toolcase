# ── Required ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
AUTH_SECRET=                       # HMAC key for session + OAuth state (use a long random string)
ANTHROPIC_API_KEY=                 # passed to spawned `claude` processes

# ── Optional: auth ───────────────────────────────────────────────────────────
# GITHUB_ALLOWED_LOGINS=octocat,hubot
# GITHUB_ALLOWED_ORG=my-org
SESSION_TTL=86400

# ── Optional: workspace ──────────────────────────────────────────────────────
WORKSPACE_DIR=/workspace
# SKILLS_DIR=/workspace/skills

# ── Optional: agent / model ──────────────────────────────────────────────────
AGENT=claude
# CLAUDE_BIN=claude
DEFAULT_MODEL=claude-sonnet-4-6
MODEL_CATALOG=fast,mid,deep,claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-8
AGENT_EXTRA_ARGS=--print --output-format=stream-json --verbose --permission-mode acceptEdits

# ── Optional: limit / retry behavior ─────────────────────────────────────────
LIMIT_AUTO_SLEEP=1
LIMIT_SLEEP_BUFFER=60
LIMIT_SLEEP_FALLBACK=1800
LIMIT_SLEEP_MAX=21600
LIMIT_MAX_RETRIES=5
TRANSIENT_MAX_RETRIES=3
TRANSIENT_BASE_DELAY=10

# ── Optional: warm session ───────────────────────────────────────────────────
WARM_SESSION=0
WARM_SESSION_MAX_AGE=14400

# ── Optional: process / generate ─────────────────────────────────────────────
FORCE_KILL_GRACE_MS=5000
GENERATE_TIMEOUT_MS=120000

# ── Optional: commit / git ───────────────────────────────────────────────────
COMMIT_AFTER_TASK=0
COMMIT_MESSAGE_MODE=taskname        # taskname | ai
COMMIT_MODEL=claude-haiku-4-5
GIT_AUTHOR_NAME=ai-task-manager
GIT_AUTHOR_EMAIL=bot@ai-task-manager.local
# GIT_REMOTE_TOKEN=                 # HTTPS token for `git push` (GitHub scope `repo`)

# ── Optional: logs / notify ──────────────────────────────────────────────────
LOG_RETENTION_HOURS=168
# SLACK_WEBHOOK_URL=

PORT=3000
